{
  "name": "speedy-bird-lynx",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.12",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "rspeedy dev",
    "build": "rspeedy build",
    "check": "tsc --noEmit",
    "lint": "biome ci .",
    "format": "biome check --write .",
    "dev:web-host": "rsbuild dev --config rsbuild.web-host.config.ts",
    "build:web-host": "rsbuild build --config rsbuild.web-host.config.ts"
  },
  "dependencies": {
    "@lynx-js/lynx-core": "0.1.4",
    "@lynx-js/react": "^0.126.2",
    "@lynx-js/web-core": "^0.26.2",
    "@lynx-js/web-elements": "^0.12.12"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@lynx-js/react-rsbuild-plugin": "^0.20.3",
    "@lynx-js/rspeedy": "^0.18.0",
    "@lynx-js/types": "^4.3.0",
    "@rsbuild/core": "^2.2.12",
    "@types/react": "^19.3.0",
    "typescript": "~6.0.3"
  },
  "overrides": {
    "dompurify": "^3.4.16",
    "serialize-javascript": "^7.1.2",
    "shell-quote": "^1.12.0",
    "source-map-js": "^1.2.2"
  }
}
