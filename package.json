{
  "name": "speedy-bird-lynx",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.12",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "rspeedy dev",
    "dev:web": "rsbuild dev --config rsbuild.web-host.config.ts",
    "build": "rspeedy build && node scripts/assets.mjs native",
    "build:web-host": "rsbuild build --config rsbuild.web-host.config.ts",
    "check": "tsc --noEmit",
    "test": "bun test tests",
    "assets:check": "node scripts/assets.mjs check",
    "assets:sync": "node scripts/assets.mjs docs"
  },
  "dependencies": {
    "@lynx-js/lynx-core": "0.1.4",
    "@lynx-js/react": "0.126.1",
    "@lynx-js/web-core": "0.26.1",
    "@lynx-js/web-elements": "0.12.11",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@lynx-js/react-rsbuild-plugin": "0.20.2",
    "@lynx-js/rspeedy": "0.17.2",
    "@lynx-js/types": "4.1.0",
    "@rsbuild/core": "2.2.7",
    "@types/bun": "1.3.12",
    "@types/react": "18.3.31",
    "happy-dom": "20.14.5",
    "sharp": "0.35.4",
    "typescript": "6.0.3"
  }
}
