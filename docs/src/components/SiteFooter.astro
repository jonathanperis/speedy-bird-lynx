---
// Colophon: credits, license, and toolchain versions read from the manifests at build time.
import { GA_ID } from '../lib/analytics';
import { REPOSITORY_URL } from '../lib/repo-files';
import { VERSIONS } from '../lib/versions';
---

<footer class="colophon">
  <div class="colophon-inner">
    <section aria-labelledby="colophon-title">
      <h2 id="colophon-title">Colophon</h2>
      <p>
        <!-- Astro drops a line break next to an element, so each sentence stays on one line. -->
        Speedy Bird is built by <a href="https://jonathanperis.github.io/">Jonathan Peris</a> to learn <a href="https://lynxjs.org/">Lynx</a>.
        Original Flappy Bird by <a href="https://en.wikipedia.org/wiki/Flappy_Bird">Dong Nguyen</a>; an earlier Canvas recreation by <a href="https://github.com/noanonoa/flappy-bird">noanonoa</a>; sprites from <a href="https://www.spriters-resource.com/fullview/59894/">The Spriters Resource</a>.
      </p>
      <p>
        Source on <a href={REPOSITORY_URL}>GitHub</a> under the <a href={`${REPOSITORY_URL}/blob/main/LICENSE`}>MIT license</a>.
        {GA_ID && (
          <>
            {' '}<button type="button" class="text-button" data-analytics-settings hidden>Analytics settings</button>
          </>
        )}
      </p>
    </section>
    <section aria-labelledby="versions-title">
      <h2 id="versions-title">Built with</h2>
      <table class="versions">
        <tbody>
          {VERSIONS.map(({ name, version, source }) => (
            <tr>
              <th scope="row">{name}</th>
              <td class="num">{version}</td>
              <td><code>{source}</code></td>
            </tr>
          ))}
        </tbody>
      </table>
    </section>
  </div>
</footer>

<style>
  .colophon {
    margin-top: 4rem;
    background: var(--sand);
    border-top: var(--border);
  }

  .colophon-inner {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr);
    gap: 2rem 3rem;
    max-width: var(--page);
    margin: 0 auto;
    padding: 2.25rem var(--gutter) 2.75rem;
  }

  h2 {
    margin-bottom: 0.6rem;
    font-size: 1.5rem;
  }

  p + p {
    margin-top: 0.6rem;
  }

  .versions th,
  .versions td {
    padding: 0.3rem 0.5rem 0.3rem 0;
    border-bottom-color: rgb(83 56 71 / 0.3);
  }

  .versions th {
    font-weight: 400;
  }

  .versions code {
    background: none;
    border: 0;
    padding: 0;
    font-size: 0.8em;
  }

  @media (max-width: 760px) {
    .colophon-inner {
      grid-template-columns: 1fr;
    }
  }
</style>
