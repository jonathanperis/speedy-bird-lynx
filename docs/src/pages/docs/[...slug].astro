---
import BaseLayout from '@/layouts/BaseLayout.astro';
import '../../styles/docs.css';
import { PAGE_META, SECTION_CATEGORIES, SECTION_ORDER } from '../../lib/docs-sidebar.config';
import { renderDoc } from '../../lib/render-doc';
import { GA_ID } from '../../lib/analytics';
import type { MarkdownInstance } from 'astro';

const globResult = import.meta.glob<MarkdownInstance<Record<string, unknown>>>('../../../wiki/*.md', { eager: true });

const pagesBySlug: Record<string, MarkdownInstance<Record<string, unknown>>> = {};
for (const [path, module] of Object.entries(globResult)) {
  const fileName = path.split('/').pop()!.replace('.md', '');
  const slug = fileName === 'index' ? 'home' : fileName;
  pagesBySlug[slug] = module;
}

// Build-time assertion: validate SECTION_CATEGORIES IDs against discovered slugs
const availableSlugs = new Set(Object.keys(pagesBySlug));
for (const cat of SECTION_CATEGORIES) {
  for (const id of cat.ids) {
    if (!availableSlugs.has(id)) {
      const catName = cat.label || "root";
      const wikiFile = id === "home" ? "index" : id;
      throw new Error(
        `SECTION_CATEGORIES references id "${id}" (category: "${catName}") but no matching wiki/${wikiFile}.md was found. Available slugs: ${Array.from(availableSlugs).join(", ")}`
      );
    }
  }
}

const requestedSlug = Astro.params.slug;
const isRoot = requestedSlug === undefined;
const requestedKey = requestedSlug ?? 'home';

const sectionsToRender = isRoot
  ? SECTION_CATEGORIES.flatMap(cat => cat.ids)
      .map(slug => ({ slug, page: pagesBySlug[slug] }))
      .filter(s => s.page)
  : (() => {
      const page = pagesBySlug[requestedKey];
      if (!page) return [];
      return [{ slug: requestedSlug!, page }];
    })();

export function getStaticPaths() {
  return [
    { params: { slug: undefined } },
    ...SECTION_ORDER.filter(id => id !== 'home').map(slug => ({ params: { slug } })),
  ];
}

const pageTitle = isRoot ? 'Speedy Bird Lynx - Documentation' : `${PAGE_META[requestedKey].title} - Speedy Bird Lynx`;
const description = isRoot
  ? 'Speedy Bird builder manual: ReactLynx architecture, game engine, assets, native builds, and CI/CD.'
  : PAGE_META[requestedKey].description;
const base = import.meta.env.BASE_URL;
const docsBase = base.replace(/\/$/, '') + '/docs';
const backHomeUrl = base.replace(/\/$/, '') + '/';
const guideUrl = (id: string) => (id === 'home' ? `${docsBase}/` : `${docsBase}/${id}/`);
const renderedSections = await Promise.all(sectionsToRender.map(async ({ slug, page }) => ({
  slug,
  html: await renderDoc(await page.compiledContent(), slug, docsBase, isRoot),
})));
---

<BaseLayout title={pageTitle} description={description}>
  <div class="mobile-header">
    <button type="button" class="menu-toggle" id="menuToggle" aria-label="Open manual navigation" aria-controls="sidebar" aria-expanded="false">
      <span></span>
      <span></span>
      <span></span>
    </button>
    <div class="repo-title">Speedy Bird Manual</div>
  </div>

  <div class="overlay" id="overlay" aria-hidden="true"></div>

  <aside class="sidebar" id="sidebar" aria-label="Manual navigation">
    <div class="sidebar-header">
      <p class="repo-title">Speedy Bird Manual</p>
      <p class="repo-description">Arcade service notes for the ReactLynx game: speed curve, engine, sprites, native shells, and deploy pipeline.</p>
      <input type="text" id="searchInput" class="search-box" placeholder="Search documentation..." aria-label="Search documentation" hidden={!isRoot}>
    </div>
    <nav class="sidebar-nav-container" aria-label="Manual pages">
      {SECTION_CATEGORIES.map((cat) => {
        const catIds = cat.ids;
        return (
          <div class="sidebar-category-group" data-category>
            {cat.label && <div class="sidebar-category">{cat.label}</div>}
            <ul>
              {catIds.map((id) => {
                // The combined manual scrolls to its sections; guide pages link to guide routes.
                const current = !isRoot && id === requestedKey;
                return (
                  <li>
                    <a
                      class:list={['nav-item', { active: current }]}
                      href={isRoot ? `#${id}` : guideUrl(id)}
                      data-nav-id={id}
                      aria-current={current ? 'page' : undefined}
                    >
                      {PAGE_META[id].title}
                    </a>
                  </li>
                );
              })}
            </ul>
          </div>
        );
      })}
    </nav>
    <div class="sidebar-footer">
      <a href={backHomeUrl} class="back-home">← Back to home</a>
      <a href="https://github.com/jonathanperis/speedy-bird-lynx" target="_blank" rel="noopener noreferrer">View on GitHub</a>
      {GA_ID && <button type="button" class="link-button" data-analytics-settings hidden>Analytics settings</button>}
      <div>Built by Jonathan Peris</div>
    </div>
  </aside>

  <div class="content-wrapper">
    <main class="content" id="main-content" tabindex="-1">
      <header class="docs-marquee">
        <div>
          <p class="manual-kicker">Builder's Manual · Night Arcade Cabinet</p>
          {isRoot
            ? <h1 class="marquee-title">Speedy Bird Service Manual</h1>
            : <p class="marquee-title">{PAGE_META[requestedKey].title}</p>}
          <p class="manual-lede">
            Source-backed guides to the speed curve, ReactLynx architecture, sprites, native hosts,
            documentation site, and release pipeline.
          </p>
        </div>
        <div class="manual-scoreboard" role="group" aria-label="Documentation quick stats">
          <div><strong>{SECTION_ORDER.length}</strong><span>Manual pages</span></div>
          <div><strong>+1%</strong><span>Speed / pipe</span></div>
          <div><strong>3</strong><span>Platforms</span></div>
        </div>
      </header>

      <nav class="manual-jumpbar" aria-label="Manual quick links">
        <a href={backHomeUrl}>Play</a>
        <a href={isRoot ? '#game-engine' : guideUrl('game-engine')}>Engine</a>
        <a href={isRoot ? '#assets-and-sprites' : guideUrl('assets-and-sprites')}>Sprites</a>
        <a href={isRoot ? '#ci-cd-pipeline' : guideUrl('ci-cd-pipeline')}>Deploy</a>
        <a href="https://github.com/jonathanperis/speedy-bird-lynx" target="_blank" rel="noopener noreferrer">GitHub</a>
      </nav>

      {renderedSections.map(({ slug, html }) => (
        <section id={slug} class="doc-section" set:html={html} />
      ))}
    </main>
  </div>

  <script is:inline define:vars={{ isRoot }}>
    const menuToggle = document.getElementById('menuToggle');
    const sidebar = document.getElementById('sidebar');
    const overlay = document.getElementById('overlay');
    const contentWrapper = document.querySelector('.content-wrapper');
    const mobile = window.matchMedia('(max-width: 768px)');
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    const navItems = document.querySelectorAll('.nav-item');
    const sections = document.querySelectorAll('section.doc-section');
    const isOpen = () => sidebar.classList.contains('open');

    // On small screens the sidebar is an off-canvas drawer. While closed it is removed from the
    // tab order and the accessibility tree; while open, the page behind it is inert.
    const sync = () => {
      const open = isOpen();
      sidebar.inert = mobile.matches && !open;
      contentWrapper.inert = mobile.matches && open;
      menuToggle.setAttribute('aria-expanded', String(open));
      menuToggle.setAttribute('aria-label', open ? 'Close manual navigation' : 'Open manual navigation');
    };
    const setOpen = (open, restoreFocus) => {
      sidebar.classList.toggle('open', open);
      overlay.classList.toggle('open', open);
      sync();
      if (open) {
        const target = sidebar.querySelector('[aria-current="page"]') ?? sidebar.querySelector('input:not([hidden]), .nav-item');
        target?.focus();
      } else if (restoreFocus) {
        menuToggle.focus();
      }
    };
    menuToggle.addEventListener('click', () => setOpen(!isOpen(), false));
    overlay.addEventListener('click', () => setOpen(false, true));
    document.addEventListener('keydown', (event) => {
      if (event.key !== 'Escape' || !isOpen()) return;
      event.preventDefault();
      setOpen(false, true);
    });
    mobile.addEventListener('change', () => (isOpen() && !mobile.matches ? setOpen(false, false) : sync()));
    sync();

    if (isRoot) {
      // Scrollspy: highlight the section in view.
      const observer = new IntersectionObserver((entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          for (const item of navItems) {
            const current = item.dataset.navId === entry.target.id;
            item.classList.toggle('active', current);
            if (current) {
              item.setAttribute('aria-current', 'location');
              item.scrollIntoView({ behavior: reducedMotion.matches ? 'auto' : 'smooth', block: 'nearest' });
            } else {
              item.removeAttribute('aria-current');
            }
          }
        }
      }, { rootMargin: '-80px 0px -60% 0px', threshold: 0 });
      sections.forEach((section) => observer.observe(section));
      navItems.forEach((item) => item.addEventListener('click', () => {
        if (mobile.matches) setOpen(false, false);
      }));

      // Search filters the combined manual's sections and their sidebar entries.
      const searchInput = document.getElementById('searchInput');
      searchInput?.addEventListener('input', () => {
        const query = searchInput.value.trim().toLowerCase();
        for (const section of sections) {
          const match = !query || section.textContent.toLowerCase().includes(query);
          section.classList.toggle('hidden-section', !match);
          const item = document.querySelector(`.nav-item[data-nav-id="${section.id}"]`);
          if (item) item.parentElement.style.display = match ? '' : 'none';
        }
        for (const group of document.querySelectorAll('.sidebar-category-group')) {
          const visible = [...group.querySelectorAll('.nav-item')].some((item) => item.parentElement.style.display !== 'none');
          group.style.display = visible ? '' : 'none';
        }
      });
    }
  </script>
</BaseLayout>
