---
import type { MarkdownInstance } from 'astro';
import SiteFooter from '../../components/SiteFooter.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { ARTICLE_NUMBERS, PAGE_META, PAGE_SOURCES, SECTION_CATEGORIES, SECTION_ORDER } from '../../lib/docs-sidebar.config';
import { renderDoc } from '../../lib/render-doc';
import { REPOSITORY_URL, repoFileExists } from '../../lib/repo-files';
import '../../styles/docs.css';

export function getStaticPaths() {
  return [{ params: { slug: undefined } }, ...SECTION_ORDER.filter((id) => id !== 'home').map((slug) => ({ params: { slug } }))];
}

const modules = import.meta.glob<MarkdownInstance<Record<string, unknown>>>('../../../wiki/*.md', { eager: true });
const pages: Record<string, MarkdownInstance<Record<string, unknown>>> = {};
for (const [path, module] of Object.entries(modules)) {
  const name = path.split('/').pop()!.replace('.md', '');
  pages[name === 'index' ? 'home' : name] = module;
}
for (const id of SECTION_ORDER) {
  if (!pages[id]) throw new Error(`docs-sidebar.config lists "${id}" but wiki/${id === 'home' ? 'index' : id}.md is missing`);
}

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const docsBase = `${base}/docs`;
const guideUrl = (id: string) => (id === 'home' ? `${docsBase}/` : `${docsBase}/${id}/`);
const slug = Astro.params.slug ?? 'home';

// Render every guide once: the current page, plus titles and text for search and prev/next.
const rendered = Object.fromEntries(
  await Promise.all(SECTION_ORDER.map(async (id) => [id, await renderDoc(await pages[id].compiledContent(), docsBase)] as const)),
);
const doc = rendered[slug];
const number = ARTICLE_NUMBERS[slug];
const index = SECTION_ORDER.indexOf(slug);
const previous = index > 0 ? SECTION_ORDER[index - 1] : undefined;
const next = index < SECTION_ORDER.length - 1 ? SECTION_ORDER[index + 1] : undefined;

// Source files this guide documents. A missing path fails the build.
const sources = (PAGE_SOURCES[slug] ?? []).map((path) => {
  if (!repoFileExists(path)) throw new Error(`PAGE_SOURCES["${slug}"] lists missing ${path}`);
  return { path, href: `${REPOSITORY_URL}/${path.endsWith('/') ? 'tree' : 'blob'}/main/${path}` };
});

const searchIndex = SECTION_ORDER.map((id) => ({
  id,
  title: PAGE_META[id].title,
  number: ARTICLE_NUMBERS[id] ?? '',
  url: guideUrl(id),
  headings: rendered[id].headings,
  text: rendered[id].text.toLowerCase(),
}));

const title = slug === 'home' ? 'Speedy Bird manual' : `${number} ${doc.title} · Speedy Bird manual`;
const description = PAGE_META[slug].description;
---

<BaseLayout title={title} description={description}>
  <SiteHeader current="manual" />

  <div class="manual">
    <nav class="toc" aria-label="Manual contents">
      <details class="toc-details" open>
        <summary>Contents</summary>
        <div class="search" role="search">
          <label class="visually-hidden" for="manual-search">Search the manual</label>
          <input id="manual-search" type="search" placeholder="Search  /" autocomplete="off" aria-controls="search-results" />
          <ol id="search-results" class="search-results" aria-live="polite" hidden></ol>
        </div>
        <ol class="toc-list">
          <li>
            <a href={guideUrl('home')} aria-current={slug === 'home' ? 'page' : undefined}>Start here</a>
          </li>
          {SECTION_CATEGORIES.filter((category) => category.label).map((category, chapter) => (
            <li>
              <span class="toc-part"><span class="num">{chapter + 1}</span> {category.label}</span>
              <ol>
                {category.ids.map((id) => (
                  <li>
                    <a href={guideUrl(id)} aria-current={id === slug ? 'page' : undefined}>
                      <span class="num">{ARTICLE_NUMBERS[id]}</span> {PAGE_META[id].title}
                    </a>
                  </li>
                ))}
              </ol>
            </li>
          ))}
        </ol>
      </details>
    </nav>

    <main id="main" tabindex="-1" class="article-column">
      <header class="article-header">
        <p class="article-number">{number ? `Article ${number}` : 'Manual'}</p>
        <h1>{slug === 'home' ? 'Speedy Bird manual' : doc.title}</h1>
        <p class="article-summary">{description}</p>
        {sources.length > 0 && (
          <p class="article-sources">
            <span>Documents</span>
            {sources.map((source) => <a href={source.href}><code>{source.path}</code></a>)}
          </p>
        )}
      </header>

      <article class="doc-section prose" set:html={doc.html} />

      <nav class="pager" aria-label="Previous and next guide">
        {previous && (
          <a class="pager-previous" href={guideUrl(previous)}>
            <span>Previous</span>
            {ARTICLE_NUMBERS[previous] ? `${ARTICLE_NUMBERS[previous]} ` : ''}{PAGE_META[previous].title}
          </a>
        )}
        {next && (
          <a class="pager-next" href={guideUrl(next)}>
            <span>Next</span>
            {ARTICLE_NUMBERS[next]} {PAGE_META[next].title}
          </a>
        )}
      </nav>
    </main>

    {doc.headings.length > 1 && (
      <nav class="on-page" aria-label="On this page">
        <p class="on-page-title">On this page</p>
        <ol>
          {doc.headings.map((heading) => <li><a href={`#${heading.id}`}>{heading.text}</a></li>)}
        </ol>
      </nav>
    )}
  </div>

  <SiteFooter />

  <script type="application/json" id="search-index" set:html={JSON.stringify(searchIndex).replace(/</g, '\\u003c')} />
  <script>
    interface Entry {
      title: string;
      number: string;
      url: string;
      headings: { id: string; text: string }[];
      text: string;
    }

    // Collapse the contents on narrow screens; keep them open on wide ones.
    const details = document.querySelector<HTMLDetailsElement>('.toc-details');
    const wide = window.matchMedia('(min-width: 980px)');
    const syncDetails = () => {
      if (details) details.open = wide.matches;
    };
    syncDetails();
    wide.addEventListener('change', syncDetails);

    // Search: matches page titles, headings, and text from an index built with the site.
    const input = document.getElementById('manual-search') as HTMLInputElement | null;
    const results = document.getElementById('search-results');
    const entries = JSON.parse(document.getElementById('search-index')?.textContent ?? '[]') as Entry[];
    const show = (query: string) => {
      if (!results) return;
      results.replaceChildren();
      const terms = query.toLowerCase().split(/\s+/).filter(Boolean);
      results.hidden = terms.length === 0;
      if (!terms.length) return;
      const matches: { label: string; url: string }[] = [];
      for (const entry of entries) {
        const has = (value: string) => terms.every((term) => value.toLowerCase().includes(term));
        if (!terms.every((term) => entry.text.includes(term) || entry.title.toLowerCase().includes(term))) continue;
        const heading = entry.headings.find((item) => has(item.text));
        const prefix = entry.number ? `${entry.number} ` : '';
        matches.push(
          heading
            ? { label: `${prefix}${entry.title} › ${heading.text}`, url: `${entry.url}#${heading.id}` }
            : { label: `${prefix}${entry.title}`, url: entry.url },
        );
      }
      if (!matches.length) {
        const empty = document.createElement('li');
        empty.className = 'search-empty';
        empty.textContent = 'No matches. Try another word.';
        results.append(empty);
        return;
      }
      for (const match of matches.slice(0, 8)) {
        const item = document.createElement('li');
        const link = document.createElement('a');
        link.href = match.url;
        link.textContent = match.label;
        item.append(link);
        results.append(item);
      }
    };
    input?.addEventListener('input', () => show(input.value));
    input?.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') {
        input.value = '';
        show('');
      }
    });
    // "/" focuses the search, unless the visitor is already typing somewhere.
    document.addEventListener('keydown', (event) => {
      const target = event.target as HTMLElement;
      if (event.key !== '/' || event.metaKey || event.ctrlKey || event.altKey) return;
      if (target.closest('input, textarea, select, [contenteditable="true"]')) return;
      event.preventDefault();
      if (details) details.open = true;
      input?.focus();
    });

    // Copy buttons on code blocks.
    for (const pre of document.querySelectorAll<HTMLPreElement>('.prose pre')) {
      const button = document.createElement('button');
      button.type = 'button';
      button.className = 'copy';
      button.textContent = 'Copy';
      button.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(pre.innerText);
          button.textContent = 'Copied';
        } catch {
          button.textContent = 'Copy failed';
        }
        window.setTimeout(() => (button.textContent = 'Copy'), 1600);
      });
      const frame = document.createElement('div');
      frame.className = 'code-frame';
      pre.replaceWith(frame);
      frame.append(button, pre);
      pre.tabIndex = 0;
    }
  </script>
</BaseLayout>
