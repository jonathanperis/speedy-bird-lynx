---
import Analytics from '../components/Analytics.astro';
import { GA_ID } from '../lib/analytics';
import '../styles/home.css';

const basePath = import.meta.env.BASE_URL.replace(/\/$/, '');
const faviconHref = `${basePath}/favicon.ico`;
const faviconPngHref = `${basePath}/favicon.png`;
const favicon32Href = `${basePath}/favicon-32x32.png`;
const appleTouchIconHref = `${basePath}/apple-touch-icon.png`;
const assetsHref = `${basePath}/assets/`;
const socialImageUrl = 'https://jonathanperis.github.io/speedy-bird-lynx/og-image.png';

const jsonLd = `{
  "@context": "https://schema.org",
  "@type": "VideoGame",
  "name": "Speedy Bird",
  "description": "A Flappy Bird-inspired arcade game with an Android ReactLynx host and a playable browser Canvas demo.",
  "url": "https://jonathanperis.github.io/speedy-bird-lynx/",
  "image": "${socialImageUrl}",
  "genre": ["Arcade", "Pixel Art", "Side-Scroller"],
  "gamePlatform": ["Web Browser", "Android"],
  "applicationCategory": "Game",
  "operatingSystem": ["Android", "Web"],
  "author": {
    "@type": "Person",
    "name": "Jonathan Peris",
    "url": "https://github.com/jonathanperis"
  },
  "isAccessibleForFree": true,
  "license": "https://github.com/jonathanperis/speedy-bird-lynx/blob/main/LICENSE",
  "codeRepository": "https://github.com/jonathanperis/speedy-bird-lynx"
}`;
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
  <title>Speedy Bird - Pixel Art Side-Scroller</title>
  <meta name="description" content="Play Speedy Bird in your browser. Explore the ReactLynx Android host, web preview, iOS source scaffold, and implementation guides.">
  <meta name="keywords" content="Speedy Bird, pixel art, Lynx, ReactLynx, cross-platform, mobile game, side-scroller, open source">
  <link rel="icon" href={faviconHref} sizes="any">
  <link rel="icon" type="image/png" href={faviconPngHref}>
  <link rel="icon" type="image/png" sizes="32x32" href={favicon32Href}>
  <link rel="apple-touch-icon" href={appleTouchIconHref}>
  <link rel="canonical" href="https://jonathanperis.github.io/speedy-bird-lynx/">

  <!-- Open Graph -->
  <meta property="og:type" content="website">
  <meta property="og:title" content="Speedy Bird - Pixel Art Side-Scroller">
  <meta property="og:description" content="Every pipe makes it faster. Play the Canvas demo and explore the ReactLynx game, Android host, and builder's manual.">
  <meta property="og:url" content="https://jonathanperis.github.io/speedy-bird-lynx/">
  <meta property="og:image" content={socialImageUrl}>
  <meta property="og:image:secure_url" content={socialImageUrl}>
  <meta property="og:image:type" content="image/png">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta property="og:image:alt" content="Speedy Bird Lynx pixel arcade preview with the bird flying between pipes">
  <meta property="og:site_name" content="Speedy Bird">
  <meta property="og:locale" content="en_US">

  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="Speedy Bird - Pixel Art Side-Scroller">
  <meta name="twitter:description" content="Every pipe makes it faster. Play the Canvas demo and explore the ReactLynx builder's manual.">
  <meta name="twitter:image" content={socialImageUrl}>
  <meta name="twitter:image:alt" content="Speedy Bird Lynx pixel arcade preview with the bird flying between pipes">
  <meta name="twitter:creator" content="@jperis_silva">

  <!-- Theme -->
  <meta name="theme-color" content="#04111e">

  <script type="application/ld+json" set:html={jsonLd}></script>

</head>
<body>
    <div class="particles">
        <div class="particle"></div><div class="particle"></div>
        <div class="particle"></div><div class="particle"></div>
        <div class="particle"></div><div class="particle"></div>
    </div>


  <!-- Sky hero -->
  <section class="hero">
    <div class="clouds-container" aria-hidden="true">
      <div class="cloud cloud-1"></div>
      <div class="cloud cloud-2"></div>
      <div class="cloud cloud-3"></div>
    </div>
    
    <div class="bird-wrapper" aria-hidden="true">
      <div class="bird">
        <div class="bird-body"></div>
        <div class="bird-wing bird-wing-bot"></div>
        <div class="bird-wing bird-wing-top"></div>
        <div class="bird-eye"></div>
        <div class="bird-beak"></div>
      </div>
    </div>

    <div class="hero-content reveal">
      <div class="cabinet-kicker">Night Arcade Cabinet · ReactLynx Case Study</div>
      <h1 class="hero-title">SPEEDY BIRD</h1>
      <p class="hero-tagline">Flappy Bird, but every pipe makes the run faster.</p>

      <div class="hero-hud" aria-label="Speedy Bird rules summary">
        <div class="speed-badge hero-hud-card">
          <div class="speed-readout"><span class="speed-num">1.00</span><span class="speed-x">×</span></div>
          <span class="speed-label">Starting Speed</span>
        </div>
        <div class="hero-hud-card">
          <strong>+1%</strong>
          <span>per pipe</span>
        </div>
        <div class="hero-hud-card">
          <strong>100</strong>
          <span>platinum run</span>
        </div>
      </div>

      <div class="hero-actions">
        <a href="#play" class="cta-btn">Start Run</a>
        <a href="#rules" class="secondary-btn">See the speed curve</a>
      </div>
      <p class="hero-control-note">Click or tap the game to flap, or press Space or Enter while it has focus.</p>
    </div>
  </section>

  <!-- Floating pill nav -->
  <nav class="pill-nav" id="pill-nav" aria-label="Speedy Bird sections">
    <a href="#play">Play</a>
    <a href="#rules">Rules</a>
    <a href="#build">Build</a>
    <a href="#docs">Docs</a>
    <a href="https://github.com/jonathanperis/speedy-bird-lynx" target="_blank" rel="noreferrer noopener">GitHub</a>
  </nav>

  <!-- Pipe divider -->
  <div class="pipe-divider" aria-hidden="true">
    <div class="pipe pipe-top"></div>
    <div class="pipe-gap"></div>
    <div class="pipe pipe-bot"></div>
  </div>

  <!-- Game Section -->
  <section id="play" class="play-section reveal" aria-label="Play Speedy Bird">
    <div class="phone-device">
      <div class="phone-chrome" aria-hidden="true">
        <div class="phone-camera"></div>
      </div>
      <div class="phone-screen" id="game" data-assets={assetsHref}>
        <canvas
          id="canvas"
          width="400"
          height="750"
          tabindex="0"
          role="application"
          aria-roledescription="game"
          aria-label="Speedy Bird"
          aria-describedby="game-help"
        >Speedy Bird needs a browser with Canvas support.</canvas>
        <p id="game-help" class="visually-hidden">
          Press Space or Enter while the game has focus, or click or tap it, to flap.
          Fly through the gaps between the pipes. Each pipe scores a point and makes the game 1% faster.
        </p>
        <p id="game-status" class="visually-hidden" role="status" aria-live="polite"></p>
      </div>
      <div class="phone-chin">
        <div class="btn-row">
          <button id="play-btn" type="button">Start Run</button>
          <button id="mute-btn" type="button" class="mute-btn" aria-pressed="false">Mute</button>
        </div>
        <div class="game-controls">
          <kbd>Space</kbd> / <kbd>Click</kbd> / <kbd>Tap</kbd> to flap
        </div>
        <div class="home-bar" aria-hidden="true"></div>
      </div>
    </div>
  </section>

  <!-- Pipe divider -->
  <div class="pipe-divider" aria-hidden="true">
    <div class="pipe pipe-top"></div>
    <div class="pipe-gap"></div>
    <div class="pipe pipe-bot"></div>
  </div>

  <!-- Rules and build sections -->
  <section id="about" class="about-section">
    <div class="about-game reveal" id="rules">
      <p class="section-kicker">Rules of the run</p>
      <h2>EVERY PIPE TURNS UP THE SPEED</h2>
      <p class="section-lede">
        Speedy Bird keeps the familiar flap-and-thread rhythm, then tightens the run after every clear.
        Pipes move 1% faster per point, so a calm opening becomes a precision test by the medal tiers.
      </p>

      <div class="difficulty-track reveal" id="speedMeter" aria-label="Speed multiplier milestones">
        <div class="track-line"><div class="speed-fill"></div></div>
        <div class="track-marker marker-start">
          <span class="marker-value">1.00×</span>
          <strong>Launch</strong>
          <small>Normal pace</small>
        </div>
        <div class="track-marker marker-bronze">
          <span class="marker-value">10</span>
          <strong>Bronze</strong>
          <small>Wake up</small>
        </div>
        <div class="track-marker marker-silver">
          <span class="marker-value">25</span>
          <strong>Silver</strong>
          <small>Fast hands</small>
        </div>
        <div class="track-marker marker-gold">
          <span class="marker-value">50</span>
          <strong>Gold</strong>
          <small>1.50× zone</small>
        </div>
        <div class="track-marker marker-platinum">
          <span class="marker-value">100</span>
          <strong>Platinum</strong>
          <small>2.00× chaos</small>
        </div>
      </div>

      <div class="medal-cabinet reveal" aria-label="Medal cabinet">
        <div class="cabinet-header">
          <span>Medal Cabinet</span>
          <strong>Try for Platinum</strong>
        </div>
        <div class="medal-slots">
          <div class="medal medal-bronze"><span>Bronze</span><small>10 pipes</small></div>
          <div class="medal medal-silver"><span>Silver</span><small>25 pipes</small></div>
          <div class="medal medal-gold"><span>Gold</span><small>50 pipes</small></div>
          <div class="medal medal-platinum"><span>Platinum</span><small>100 pipes</small></div>
        </div>
      </div>
    </div>

    <div class="about-project reveal" id="build">
      <p class="section-kicker">Builder's manual</p>
      <h2>BUILT AS A REAL CROSS-PLATFORM GAME</h2>
      <p class="section-lede">
        The Canvas demo above runs the same rules module as the ReactLynx game: identical physics, seeded
        pipes, scoring, and restart lock, simulated in fixed 1/60 s steps on the same 400×750 playfield.
        Only the renderer and input differ. Here sound comes from the Web Audio API; the ReactLynx app plays
        it through a host-provided <code>SpeedyBirdModule</code>.
      </p>

      <div class="manual-grid">
        <article class="manual-panel panel-wide">
          <span class="panel-code">ENGINE / 1/60 S STEPS</span>
          <h3>Physics that stay readable as speed climbs</h3>
          <p>Gravity, velocity-based flaps, smooth tilt, AABB collision, and seeded constant-gap pipes run in fixed steps, so the speed never depends on the display's refresh rate.</p>
        </article>
        <article class="manual-panel">
          <span class="panel-code">SPRITES</span>
          <h3>Tile-Based Pipes</h3>
          <p>Pipe bodies repeat from pixel tiles with cap sprites, avoiding stretched art at every obstacle height.</p>
        </article>
        <article class="manual-panel">
          <span class="panel-code">WORLD</span>
          <h3>Parallax Layers</h3>
          <p>Background, pipes, and ground move at different speeds to make the tiny scene feel alive.</p>
        </article>
        <article class="manual-panel">
          <span class="panel-code">LYNX</span>
          <h3>ReactLynx Port</h3>
          <p>The game loop runs on Lynx's main thread in the Android host and the Lynx web preview; the iOS host is built from source in Xcode. This page draws the same engine with Canvas.</p>
        </article>
        <article class="manual-panel">
          <span class="panel-code">SHIP</span>
          <h3>CI/CD Ready</h3>
          <p>GitHub Actions check bundles, Android builds, and docs, then publish Pages and release artifacts. iOS archives require a tracked Xcode project and are always unsigned.</p>
        </article>
      </div>
    </div>

    <div class="about-lynx reveal">
      <p class="section-kicker">Native UI framework</p>
      <h2>WHAT IS LYNX?</h2>
      <p>
        <a href="https://lynxjs.org/" target="_blank" rel="noreferrer noopener" class="text-link">Lynx</a>
        is ByteDance's open-source cross-platform native UI framework. ReactLynx brings React patterns
        to a native rendering engine instead of a WebView, which makes this project a compact game-shaped
        proof of the framework's rendering, touch input, asset, and release pipeline.
      </p>
      <div class="lynx-strip" aria-label="Lynx platform highlights">
        <span>React components</span>
        <span>Native rendering</span>
        <span>CSS transforms</span>
        <span>Rspack toolchain</span>
        <span>Android · Web</span>
        <span>iOS source scaffold</span>
      </div>
    </div>
  </section>

  <!-- Docs -->
  <section id="docs" class="docs-section reveal">
    <p class="section-kicker">Source and docs</p>
    <h2>BUILDER'S MANUAL</h2>
    <p class="docs-lede">Open the manual when you want implementation details, native host setup, or release notes.</p>
    <p class="docs-cta-row">
      <a href="docs/" class="cta-btn docs-primary">View full documentation</a>
      <a href="https://github.com/jonathanperis/speedy-bird-lynx" class="secondary-btn docs-secondary" target="_blank" rel="noreferrer noopener">View source</a>
    </p>
    <div class="docs-grid">
      <a class="doc-card" href="docs/">
        <span class="doc-index">01</span>
        <h3>Start Here</h3>
        <p>Project overview, Lynx setup, architecture, and getting started.</p>
      </a>
      <a class="doc-card" href="docs/game-engine/">
        <span class="doc-index">02</span>
        <h3>Game Engine</h3>
        <p>Physics, collision detection, scoring, and game state machine.</p>
      </a>
      <a class="doc-card" href="docs/architecture/">
        <span class="doc-index">03</span>
        <h3>Architecture</h3>
        <p>File structure, game loop, component hierarchy, and module breakdown.</p>
      </a>
      <a class="doc-card" href="docs/assets-and-sprites/">
        <span class="doc-index">04</span>
        <h3>Assets &amp; Sprites</h3>
        <p>Sprites, audio files, tile-based rendering, and asset attribution.</p>
      </a>
      <a class="doc-card" href="docs/getting-started/">
        <span class="doc-index">05</span>
        <h3>Run It Locally</h3>
        <p>Controls, local setup, and Lynx Explorer testing for mobile devices.</p>
      </a>
      <a class="doc-card" href="docs/dependency-updates/">
        <span class="doc-index">06</span>
        <h3>Dependencies &amp; Upgrades</h3>
        <p>Current versions, compatibility holds, native toolchains, and verification.</p>
      </a>
    </div>
  </section>

  <!-- Footer -->
  <footer>
    <p>
      <a href="https://github.com/jonathanperis/speedy-bird-lynx" target="_blank" rel="noreferrer noopener">GitHub Repository</a>
      &nbsp;&middot;&nbsp;
      <a href="docs/">Documentation</a>
    </p>
    <p style="margin-top: 0.5rem;">
      Created by <a href="https://github.com/jonathanperis" target="_blank" rel="noreferrer noopener">jonathanperis</a>.
      Original Flappy Bird by <a href="https://en.wikipedia.org/wiki/Flappy_Bird" target="_blank" rel="noreferrer noopener">Dong Nguyen</a>.
      Earlier Canvas recreation by <a href="https://github.com/noanonoa/flappy-bird" target="_blank" rel="noreferrer noopener">noanonoa</a>.
    </p>
    <p style="margin-top: 0.25rem;">
      Sprites from <a href="https://www.spriters-resource.com/fullview/59894/" target="_blank" rel="noreferrer noopener">The Spriters Resource</a>.
    </p>
    {GA_ID && (
      <p class="footer-settings">
        <button type="button" class="link-button" data-analytics-settings hidden>Analytics settings</button>
      </p>
    )}
  </footer>

  <!-- Navigation and section reveals -->
  <script is:inline>
    // Pill nav appear
    const heroEl = document.querySelector('.hero');
    const navEl = document.getElementById('pill-nav');
    if (window.IntersectionObserver) {
      new IntersectionObserver(([e]) => navEl.classList.toggle('visible', !e.isIntersecting)).observe(heroEl);
    }
    
    // Section reveals
    if (window.IntersectionObserver) {
      document.querySelectorAll('.reveal').forEach(el => {
        new IntersectionObserver(([e]) => { if (e.isIntersecting) el.classList.add('visible'); }, { threshold: 0.1 }).observe(el);
      });
      // Speed meter reveal separately for its animation
      const meter = document.getElementById('speedMeter');
      if (meter) {
        new IntersectionObserver(([e]) => { if (e.isIntersecting) meter.classList.add('visible'); }, { threshold: 0.5 }).observe(meter);
      }
    } else {
      document.querySelectorAll('.reveal').forEach(el => el.classList.add('visible'));
    }
    
    // Init immediate reveals
    setTimeout(() => {
      document.querySelector('.hero-content').classList.add('visible');
    }, 100);
  </script>

  <!-- Canvas demo: shares src/game/engine.ts with the ReactLynx app -->
  <script>
    import { mountDemo } from '../game/controller.ts';

    const root = document.getElementById('game');
    const canvas = document.getElementById('canvas');
    const startButton = document.getElementById('play-btn');
    const status = document.getElementById('game-status');
    if (root && canvas instanceof HTMLCanvasElement && startButton instanceof HTMLButtonElement && status) {
      mountDemo({
        root,
        canvas,
        startButton,
        muteButton: document.getElementById('mute-btn') as HTMLButtonElement | null,
        status,
        assetsUrl: new URL(root.dataset.assets ?? 'assets/', document.baseURI),
      });
    }
  </script>

  <Analytics />
</body>
</html>
