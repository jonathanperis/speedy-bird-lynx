---
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/arcade.css';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const manuals = [
  ['getting-started', 'Start here', 'Install, build, and compare the three game surfaces.'],
  ['game-engine', 'Inside the engine', 'Fixed steps, seeded randomness, collision geometry, and replay.'],
  ['learning-labs', 'Learning labs', 'Pause a run, inspect its hitboxes, and test a hypothesis.'],
  ['reactlynx-upgrade', 'ReactLynx field notes', 'What changed, what we adopted, and what needs measurement.'],
  ['native-host-apps', 'Native hosts', 'Audio, storage, lifecycle, and offline packaging.'],
  ['ci-cd-pipeline', 'Ship a build', 'Tests, signing, artifact verification, and release ownership.'],
];
---
<BaseLayout title="Speedy Bird — Arcade & Learning Sandbox">
  <main>
    <section id="hero" class="arcade-hero">
      <div class="sky-cloud cloud-one" aria-hidden="true"></div>
      <div class="sky-cloud cloud-two" aria-hidden="true"></div>
      <img class="hero-bird" src={`${base}/assets/sprites/bird-1.png`} alt="" width="102" height="72" />
      <p class="eyebrow">Night Arcade Cabinet · ReactLynx Learning Sandbox</p>
      <h1>SPEEDY BIRD</h1>
      <p class="hero-tagline">Flappy Bird, but every pipe makes the run faster.</p>
      <div class="hero-hud" aria-label="Game rules summary">
        <div><strong><span id="speedNum">1.00</span>×</strong><span>Live multiplier</span></div>
        <div><strong>+1%</strong><span>Per pipe</span></div>
        <div><strong>100</strong><span>Platinum run</span></div>
      </div>
      <div class="hero-actions"><a class="arcade-button" href="#play">Start run</a><a class="secondary-button" href="#labs">Open the service panel</a></div>
      <p>Space / Click / Tap to flap. Pause any time to learn how it works.</p>
    </section>

    <section id="play" class="play-section" aria-label="Play Speedy Bird">
      <div class="arcade-cabinet" data-game-root data-asset-base={`${base}/`}>
        <div class="cabinet-marquee"><span>Speedy Bird</span><output data-game-score>Score 0 · Best 0 · 1.00×</output></div>
        <canvas id="canvas" width="400" height="600" tabindex="0" aria-label="Speedy Bird game. Space or tap to flap; P to pause." aria-describedby="game-instructions game-status">
          Use the controls below to start, pause, or replay a run. Scores and game status are also shown as text.
        </canvas>
        <p id="game-status" data-game-status role="status" aria-live="polite">Ready to load</p>
        <div class="game-buttons">
          <button class="arcade-button" data-game-action="start">Start run</button>
          <button data-game-action="pause">Pause</button>
          <button data-game-action="mute" aria-pressed="false">Mute</button>
        </div>
        <p id="game-instructions"><kbd>Space</kbd> / Click / Tap: flap · <kbd>P</kbd>: pause</p>
        <details id="labs" class="service-panel">
          <summary>Learning controls</summary>
          <p>Inspect the same simulation used by the native app. Practice uses a wider gap and a slower clock.</p>
          <div class="game-buttons">
            <button data-game-action="step">Single step</button>
            <button data-game-action="replay">Replay run</button>
            <button data-game-action="practice" aria-pressed="false">Practice</button>
            <button data-game-action="debug" aria-pressed="false">Hitboxes & metrics</button>
          </div>
          <label for="game-seed">Random seed <input id="game-seed" data-game-seed type="number" min="0" max="4294967295" step="1" value="1" required /></label>
          <p data-game-metrics hidden></p>
          <a href={`${base}/docs/learning-labs/`}>Follow a guided experiment →</a>
        </details>
      </div>
    </section>

    <section id="rules" class="arcade-section">
      <p class="eyebrow">Rules of the run</p><h2>EVERY PIPE TURNS UP THE SPEED</h2>
      <p>Gravity stays familiar. Every pipe that leaves the screen adds one point and increases world speed by 1% of its starting speed. Reach 50 points for 1.5× speed, or 100 for 2×.</p>
      <div class="medal-cabinet" aria-label="Medal thresholds">
        {([['bronze', 10], ['silver', 25], ['gold', 50], ['platinum', 100]] as const).map(([medal, points]) => <div>
          <img src={`${base}/assets/sprites/medals/medal-${medal}.png`} alt="" width="44" height="44" loading="lazy" />
          <strong>{medal}</strong><span>{points} points</span>
        </div>)}
      </div>
    </section>

    <section id="build" class="arcade-section">
      <p class="eyebrow">Builder's manual</p><h2>ONE GAME. MANY LESSONS.</h2>
      <p>ReactLynx renders native elements. Canvas paints pixels. Both use the same TypeScript physics, collision, seeded randomness, and replay engine. This is a sandbox for understanding those differences through experiments.</p>
      <div class="platform-strip"><span>ReactLynx 0.126.1</span><span>Android + iOS hosts</span><span>Canvas + Lynx for Web</span></div>
      <p>Native bundles target Lynx engine 3.9 on SDK 4.1 hosts. The browser cabinet uses a 400×600 world; the native game uses 400×750. Each derives collision boundaries from its configured world.</p>
      <a class="text-link" href="https://github.com/jonathanperis/speedy-bird-lynx" target="_blank" rel="noreferrer noopener">Explore the source →</a>
    </section>

    <section id="docs" class="arcade-section">
      <p class="eyebrow">Source and experiments</p><h2>OPEN THE MANUAL</h2>
      <div class="manual-grid">{manuals.map(([slug, title, description], i) => <a href={`${base}/docs/${slug}/`}>
        <span class="eyebrow">0{i + 1}</span><h3>{title}</h3><p>{description}</p>
      </a>)}</div>
    </section>
  </main>
  <footer class="arcade-footer">
    <p>Built by <a href="https://github.com/jonathanperis">Jonathan Peris</a> · <a href={`${base}/docs/`}>Documentation</a> · <a href="https://github.com/jonathanperis/speedy-bird-lynx">GitHub</a></p>
    <p>Inspired by Dong Nguyen's Flappy Bird and <a href="https://github.com/noanonoa">noanonoa's original implementation</a>. <a href={`${base}/docs/assets-and-sprites/`}>Asset credits</a>.</p>
  </footer>
</BaseLayout>
<script>
  import { mountGame } from '../game/controller';
  const root = document.querySelector<HTMLElement>('[data-game-root]')!;
  mountGame(root, root.dataset.assetBase!);
</script>
