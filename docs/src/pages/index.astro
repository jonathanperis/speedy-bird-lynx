---
import { Code } from 'astro:components';
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { BG_H, BG_W, CANVAS_HEIGHT, CANVAS_WIDTH, GROUND_H, GROUND_W } from '../../../src/constants.ts';
import { BRIDGE_ROWS, HOST_LINKS } from '../lib/bridge';
import { paperTheme } from '../lib/code-theme.mjs';
import { PAGE_META, SECTION_CATEGORIES } from '../lib/docs-sidebar.config';
import { FACTS, fixed, SPAWN_FLOOR_SCORE, SPEED_ROWS } from '../lib/game-facts';
import { LYNX_RUNTIME } from '../lib/lynx-runtime';
import { excerpt, REPOSITORY_URL, sourceUrl } from '../lib/repo-files';
import '../styles/home.css';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const assets = `${base}/assets/`;
const docs = `${base}/docs/`;
// The real ReactLynx build: main.web.bundle and the Lynx web runtime (`bun run build:site`).
const play = `${base}/play/`;
// The game's still scenery, drawn in HTML so the scene is on screen before the Lynx runtime
// paints the same frame over it. Positions come from the game's constants, as percentages of
// the 400x750 playfield.
const percent = (value: number, total: number) => `${((value / total) * 100).toFixed(3)}%`;
const scenery = [
  `--city: url(${assets}sprites/background.png)`,
  `--ground: url(${assets}sprites/ground.png)`,
  `--city-top: ${percent(CANVAS_HEIGHT - GROUND_H - BG_H, CANVAS_HEIGHT)}`,
  `--city-height: ${percent(BG_H, CANVAS_HEIGHT)}`,
  `--city-width: ${percent(BG_W, CANVAS_WIDTH)}`,
  `--ground-top: ${percent(CANVAS_HEIGHT - GROUND_H, CANVAS_HEIGHT)}`,
  `--ground-width: ${percent(GROUND_W, CANVAS_WIDTH)}`,
].join('; ');
const siteUrl = 'https://jonathanperis.github.io/speedy-bird-lynx/';
const frameLoop = excerpt('src/hooks/useGame.ts', 'frame-loop');

// Sheet 1 chart: speed against score, from the same rows as the table.
const chart = { width: 560, height: 260, left: 44, right: 18, top: 16, bottom: 46 };
const maxScore = SPAWN_FLOOR_SCORE;
const maxSpeed = Math.ceil(SPEED_ROWS.at(-1)!.speed);
const x = (score: number) => chart.left + (score / maxScore) * (chart.width - chart.left - chart.right);
const y = (speed: number) =>
  chart.height - chart.bottom - ((speed - 1) / (maxSpeed - 1)) * (chart.height - chart.top - chart.bottom);
const speedPath = SPEED_ROWS.map((row) => `${x(row.score).toFixed(1)},${y(row.speed).toFixed(1)}`).join(' ');
const yTicks = Array.from({ length: maxSpeed }, (_, index) => index + 1);
const medalRows = SPEED_ROWS.filter((row) => row.medal);
// Label the x axis at round scores so the medal scores' close dots never crowd the labels.
const xTicks = [0, 50, 100, 150, 200, 250].filter((score) => score < maxScore - 15);

// Manual contents, numbered like articles: 1, 1.1, 1.2, ...
let chapter = 0;
const contents = SECTION_CATEGORIES.filter((category) => category.label).map((category) => {
  chapter++;
  return {
    number: chapter,
    label: category.label,
    pages: category.ids.map((id, index) => ({
      number: `${chapter}.${index + 1}`,
      title: PAGE_META[id].title,
      description: PAGE_META[id].description,
      href: `${docs}${id}/`,
    })),
  };
});

const author = { '@type': 'Person', name: 'Jonathan Peris', url: 'https://jonathanperis.github.io/' };
const license = `${REPOSITORY_URL}/blob/main/LICENSE`;
const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'VideoGame',
      '@id': `${siteUrl}#game`,
      name: 'Speedy Bird',
      description: 'Flappy Bird where every pipe you clear makes the game 1% faster. Built with ReactLynx for Android, iOS, and the Web.',
      url: siteUrl,
      image: `${siteUrl}og-image.png`,
      genre: ['Arcade', 'Side-Scroller'],
      gamePlatform: ['Web Browser', 'Android', 'iOS'],
      applicationCategory: 'GameApplication',
      author,
      isAccessibleForFree: true,
      license,
    },
    {
      '@type': 'SoftwareSourceCode',
      '@id': `${siteUrl}#source`,
      name: 'Speedy Bird Lynx source code',
      codeRepository: REPOSITORY_URL,
      programmingLanguage: 'TypeScript',
      runtimePlatform: 'ReactLynx',
      license,
      author,
      targetProduct: { '@id': `${siteUrl}#game` },
    },
  ],
};
---

<BaseLayout
  title="Speedy Bird: Flappy Bird where every pipe makes it faster"
  description="Play Speedy Bird in your browser. Every pipe you clear makes the game 1% faster. Built with ReactLynx for Android, iOS, and the Web."
  structuredData={structuredData}
>
  <Fragment slot="head">
    <link rel="preload" as="image" href={`${assets}sprites/background.png`} fetchpriority="high" />
    {LYNX_RUNTIME.css.map((file) => <link rel="stylesheet" href={`${play}${file}`} />)}
    {LYNX_RUNTIME.js.map((file) => <script is:inline defer src={`${play}${file}`} />)}
  </Fragment>

  <SiteHeader />

  <main id="main" tabindex="-1">
    <section class="band" id="play" aria-labelledby="game-title">
      <div class="band-inner">
        <div class="intro">
          <h1 id="game-title">Speedy Bird</h1>
          <p class="pitch">Flappy Bird where every pipe you clear makes the game {FACTS.percentPerPoint}% faster.</p>
          <button id="play-btn" type="button" class="button button-primary">Start a run</button>
        </div>

        <div class="stage">
          <div class="game" id="game" data-play={play} aria-busy="true">
            <div class="scenery" style={scenery} aria-hidden="true">
              <div class="scenery-city"></div>
              <div class="scenery-ground"></div>
            </div>
            <lynx-view
              id="lynx"
              tabindex="0"
              role="application"
              aria-roledescription="game"
              aria-label="Speedy Bird"
              aria-describedby="game-help"
            ></lynx-view>
            <p class="game-message" id="game-message">
              Loading <code>main.web.bundle</code>…
              <noscript><br />The game needs JavaScript.</noscript>
            </p>
            <p id="game-help" class="visually-hidden">
              Press Space or Enter while the game has focus, or click or tap it, to flap. Fly through the
              gaps. Each pipe scores a point and makes the game {FACTS.percentPerPoint}% faster.
            </p>
            <p id="game-status" class="visually-hidden" role="status" aria-live="polite"></p>
          </div>

          <div class="side">
            <p class="controls">
              Tap or click the game, or press <kbd>Space</kbd> while it has focus.
              <button id="mute-btn" type="button" class="text-button" aria-pressed="false">Mute sound</button>
            </p>
            <section class="timing" id="timing" aria-labelledby="timing-title" data-state="loading">
              <h2 id="timing-title">
                <span data-field="run">No runs yet</span>
                <span class="timing-state" data-field="state">Loading</span>
              </h2>
              <dl>
                <div><dt>Pipes cleared</dt><dd class="num" data-field="score">0</dd></div>
                <div><dt>Speed</dt><dd class="num"><span data-field="speed">1.00</span><small>×</small></dd></div>
                <div><dt>Scroll</dt><dd class="num"><span data-field="scroll">{fixed(FACTS.baseScroll)}</span><small>px/step</small></dd></div>
                <div><dt>Next pipe every</dt><dd class="num"><span data-field="spawn">{FACTS.baseSpawnSteps}</span><small>steps</small></dd></div>
                <div><dt>Next medal</dt><dd data-field="medal">Bronze in {FACTS.medals.bronze}</dd></div>
                <div><dt>Best</dt><dd class="num" data-field="best">0</dd></div>
              </dl>
              <p class="timing-note">
                The game is the ReactLynx app itself, <code>main.web.bundle</code> in a <code>&lt;lynx-view&gt;</code>.
                It reports these values through <a href={sourceUrl('src/hooks/useGame.ts')}><code>SpeedyBirdModule</code></a>.
              </p>
            </section>
          </div>
        </div>
      </div>
      <div class="ground-strip" style={`--ground: url(${assets}sprites/ground.png)`} aria-hidden="true"></div>
    </section>

    <div class="page" id="how-it-works">
      <section class="sheet" aria-labelledby="curve-title">
        <p class="sheet-caption">Sheet 1 · Speed by score</p>
        <h2 id="curve-title">The speed curve</h2>
        <p class="lede">
          Speed is <code>1 + score ÷ 100</code>: each point adds {FACTS.percentPerPoint}% to how fast the pipes and
          ground scroll. Pipes also spawn closer together until score {SPAWN_FLOOR_SCORE}, where the gap between
          them stops shrinking at {FACTS.minSpawnSteps} steps.
        </p>
        <div class="curve">
          <div class="table-wrap">
            <table>
              <caption class="visually-hidden">Speed, scroll distance, and pipe interval by score</caption>
              <thead>
                <tr>
                  <th scope="col">Score</th>
                  <th scope="col" class="right">Speed</th>
                  <th scope="col" class="right">Scroll</th>
                  <th scope="col" class="right">Pipe every</th>
                  <th scope="col">Medal</th>
                </tr>
              </thead>
              <tbody>
                {SPEED_ROWS.map((row) => (
                  <tr>
                    <th scope="row" class="num">{row.score}</th>
                    <td class="num right">{fixed(row.speed)}<small>×</small></td>
                    <td class="num right">{fixed(row.scroll)}<small>px</small></td>
                    <td class="num right">{row.pipeEverySteps}<small> steps · {fixed(row.pipeEverySeconds)} s</small></td>
                    <td class="medal-cell">
                      {row.medal ? (
                        <>
                          <img class="sprite" src={`${assets}sprites/medals/medal-${row.medal}.png`} width="22" height="22" alt="" />
                          <span>{row.medal[0].toUpperCase() + row.medal.slice(1)}</span>
                        </>
                      ) : row.note ? <span class="muted">{row.note}</span> : null}
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
          <figure class="chart">
            <svg viewBox={`0 0 ${chart.width} ${chart.height}`} role="img" aria-labelledby="chart-title">
              <title id="chart-title">Speed rises in a straight line from 1× at score 0 to {fixed(SPEED_ROWS.at(-1)!.speed)}× at score {maxScore}.</title>
              {yTicks.map((tick) => (
                <g>
                  <line class="grid" x1={chart.left} x2={chart.width - chart.right} y1={y(tick)} y2={y(tick)} />
                  <text class="tick" x={chart.left - 6} y={y(tick) + 4} text-anchor="end">{tick}×</text>
                </g>
              ))}
              <line class="axis" x1={chart.left} x2={chart.width - chart.right} y1={chart.height - chart.bottom} y2={chart.height - chart.bottom} />
              <line class="axis" x1={chart.left} x2={chart.left} y1={chart.top} y2={chart.height - chart.bottom} />
              {medalRows.map((row) => (
                <line class="marker" x1={x(row.score)} x2={x(row.score)} y1={y(row.speed)} y2={chart.height - chart.bottom} />
              ))}
              {xTicks.map((score) => (
                <text class="tick" x={x(score)} y={chart.height - chart.bottom + 16} text-anchor="middle">{score}</text>
              ))}
              <text class="tick" x={x(maxScore)} y={chart.height - chart.bottom + 16} text-anchor="middle">{maxScore}</text>
              <polyline class="line" points={speedPath} />
              {medalRows.map((row) => <circle class="dot" cx={x(row.score)} cy={y(row.speed)} r="4.5" />)}
              <text class="axis-label" x={chart.left + (chart.width - chart.left - chart.right) / 2} y={chart.height - 6} text-anchor="middle">score</text>
              <text class="axis-label" x={12} y={chart.top + (chart.height - chart.top - chart.bottom) / 2} text-anchor="middle" transform={`rotate(-90 12 ${chart.top + (chart.height - chart.top - chart.bottom) / 2})`}>speed</text>
            </svg>
            <figcaption>Dots mark the medal scores. Computed from <a href={sourceUrl('src/game/engine.ts')}><code>engine.ts</code></a> when this page was built.</figcaption>
          </figure>
        </div>
      </section>

      <section class="sheet" aria-labelledby="hosts-title">
        <p class="sheet-caption">Sheet 2 · One bundle, three hosts</p>
        <h2 id="hosts-title">The same game on Android, iOS, and the Web</h2>
        <p class="lede">
          <code>bun run build</code> produces one Lynx bundle. Each host is a thin native shell that loads it and
          answers the same five calls through a native module named <code>SpeedyBirdModule</code>: sound, the saved
          best score, and screen-reader announcements.
        </p>
        <ol class="hosts" aria-label="Hosts that load main.lynx.bundle">
          <li class="bundle"><span class="host-name">main.lynx.bundle</span><span class="host-detail">ReactLynx · one build</span></li>
          <li><a href={HOST_LINKS.android}><span class="host-name">Android</span></a><span class="host-detail">Kotlin · LynxView</span></li>
          <li><a href={HOST_LINKS.ios}><span class="host-name">iOS</span></a><span class="host-detail">Swift · LynxView</span></li>
          <li><a href={HOST_LINKS.web}><span class="host-name">Web</span></a><span class="host-detail">&lt;lynx-view&gt;</span></li>
        </ol>
        <div class="table-wrap">
          <table>
            <caption class="visually-hidden">How each host implements SpeedyBirdModule</caption>
            <thead>
              <tr><th scope="col">Call</th><th scope="col">Android</th><th scope="col">iOS</th><th scope="col">Web</th></tr>
            </thead>
            <tbody>
              {BRIDGE_ROWS.map((row) => (
                <tr><th scope="row"><code>{row.method}</code></th><td>{row.android}</td><td>{row.ios}</td><td>{row.web}</td></tr>
              ))}
            </tbody>
          </table>
        </div>
        <p class="note">The build checks each host's source for these methods, so this table fails the build if it goes out of date.</p>
      </section>

      <section class="sheet" aria-labelledby="threads-title">
        <p class="sheet-caption">Sheet 3 · What runs where</p>
        <h2 id="threads-title">The frame loop runs on Lynx's main thread</h2>
        <div class="threads">
          <div class="thread-notes">
            <p class="lede">
              Lynx has two threads: a main thread that owns the screen and a background thread for app logic.
              Taps, the simulation, and every per-frame style change stay on the main thread, so a flap shows up in
              the next frame. React on the background thread only redraws the score and overlays when they change.
            </p>
            <ol class="annotations">
              <li><strong>Steps.</strong> Elapsed time becomes fixed 1/{FACTS.stepsPerSecond} s steps, so speed never depends on the display's refresh rate.</li>
              <li><strong>Render.</strong> <code>render()</code> writes transforms with <code>setStyleProperties</code>; React is not involved.</li>
              <li><strong>Publish.</strong> <code>publish()</code> crosses to the background thread only when the score, state, or sounds change.</li>
            </ol>
          </div>
          <figure class="excerpt">
            <figcaption>
              <a href={frameLoop.url}><code>{frameLoop.path}</code></a>, line {frameLoop.startLine}
            </figcaption>
            <Code code={frameLoop.code} lang="ts" theme={paperTheme} />
          </figure>
        </div>
      </section>

      <section class="sheet" aria-labelledby="manual-title">
        <p class="sheet-caption">Manual</p>
        <h2 id="manual-title">Read how it is built</h2>
        <ol class="contents">
          {contents.map((part) => (
            <li>
              <h3><span class="num">{part.number}</span> {part.label}</h3>
              <ol>
                {part.pages.map((page) => (
                  <li>
                    <a href={page.href}><span class="num">{page.number}</span> {page.title}</a>
                    <p>{page.description}</p>
                  </li>
                ))}
              </ol>
            </li>
          ))}
        </ol>
        <p><a class="button" href={docs}>Open the manual</a></p>
      </section>
    </div>
  </main>

  <SiteFooter />

  <script>
    import { mountGame } from '../scripts/game.ts';

    mountGame();
  </script>
</BaseLayout>
